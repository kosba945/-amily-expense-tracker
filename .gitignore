**/*.keychain
**/*.keychain-db

# Local financial data, backups, and exports
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.backup
**/*.bak
**/*.dump
**/*.csv
**/*.xlsx

# Xcode per-user state and build products
**/xcuserdata/
*.xcuserstate
*.xcresult/
*.xcarchive/

# Local app packages and generated deliverables
/outputs/
*.apk
*.aab
*.ipa

# Crash reports
*.ips
*.crash

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
