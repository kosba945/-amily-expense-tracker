# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.flutter-plugins
.pub-cache/
.pub/
**/build/
/coverage/

# Local secrets and signing credentials
.env
.env.*
!.env.example
!.env.template
**/local.properties
**/key.properties
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
**/*.p8
**/*.pem
**/*.mobileprovision
**/*.provisionprofile
